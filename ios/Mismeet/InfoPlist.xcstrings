        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Mismeet shows your location to the contacts you choose."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mismeet näyttää sijaintisi valitsemillesi yhteystiedoille."
