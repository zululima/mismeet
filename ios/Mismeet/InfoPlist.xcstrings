    "NSCameraUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Mismeet scans the invite QR code of a contact."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mismeet skannaa yhteystiedon kutsun QR-koodin."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Mismeet keeps your contacts updated also while the app is not open."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mismeet pitää yhteystietosi ajan tasalla myös silloin, kun appi ei ole auki."
          }
        }
      }
