        }
      }
    },
    "Off for the whole phone, under Settings > Privacy & Security > Location Services.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pois koko puhelimesta, kohdassa Asetukset > Tietosuoja ja suojaus > Sijaintipalvelut."
          }
        }
      }
    },
    "Off: contacts see a point that can be kilometres away.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pois: yhteystiedot näkevät pisteen, joka voi olla kilometrien päässä."
          }
        }
      }
    },
    "Off: this phone only watches its contacts and needs no location permission.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pois: tämä puhelin vain seuraa yhteystietojaan eikä tarvitse sijaintilupaa."
