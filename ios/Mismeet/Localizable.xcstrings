    "Shown to the people you add, so they know who asks to be added back. You can leave it empty.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytetään lisäämillesi ihmisille, jotta he tietävät, kuka pyytää lisäämään takaisin. Voit jättää sen tyhjäksi."
          }
        }
      }
    },
    "Skip": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohita"
          }
        }
      }
    },
    "That contact is already in the list.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteystieto on jo listalla."
          }
        }
      }
    },
    "That is your own invite.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on oma kutsusi."
          }
        }
      }
    },
