        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se menee salattuna kehittäjälle, vain tätä raporttia varten tehdyllä avaimella. Siinä ei ole sijaintia, yhteystietojen nimiä eikä avaimia."
          }
        }
      }
    },
