{
  "sourceLanguage": "en",
  "strings": {
    "%@ added you": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lisäsi sinut"
          }
        }
      }
    },
    "%@ sees where you are until you turn it off in their card.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ näkee sijaintisi, kunnes laitat jakamisen pois hänen kortistaan."
          }
        }
      }
    },
    "%@, no longer sharing": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ei enää jaa"
          }
        }
      }
    },
    "%@, seen %@": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, nähty %2$@"
          }
        }
      }
    },
    "%@, within %lld m": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, tarkkuus %2$lld m"
          }
        }
      }
    },
    "%@. An iPhone shares when it has moved about 500 m and when Mismeet opens.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. iPhone jakaa, kun se on liikkunut noin 500 m ja kun Mismeet avataan."
          }
        }
      }
    },
    "%lld contacts": {
      "localizations": {
        "en": {
          "variations": {
